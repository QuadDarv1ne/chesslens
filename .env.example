# Переменные окружения ChessLens.
# Скопируйте в .env: cp .env.example .env
# ⚠️ Никогда не коммитьте .env — он в .gitignore

# SQLite. Разрешено менять путь в .env; по умолчанию — путь к prisma CLI.
# Опциональный путь — путь к базе данных prisma CLI.
DATABASE_URL="file:../db/custom.db"

# ─── Платежи ───────────────────────────────────────────────────────
# PAYMENT_PROVIDER — провайдер по умолчанию: yookassa | tbank | sbp | ozonpay | mock
# В dev (NODE_ENV !== 'production') по умолчанию mock.
PAYMENT_PROVIDER=mock

# Секрет для вебхуков провайдеров. В production обязателен:
# без него POST /api/payments/webhook отклоняется (500), чтобы никто
# не мог подтвердить платёж вручную и получить Pro бесплатно.
# URL вебхука: https://<host>/api/payments/webhook?token=<PAYMENT_WEBHOOK_SECRET>
# PAYMENT_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Ozon Pay (нужна при PAYMENT_PROVIDER=ozonpay):
# OZON_PAY_CLIENT_ID=your_client_id
# OZON_PAY_API_KEY=your_api_key

# СБП (для привязки номера при оплате через СБП):
# SBP_PHONE=+79XXXXXXXXX

# ЮKassa (нужна при PAYMENT_PROVIDER=yookassa):
# YOOKASSA_SHOP_ID=your_shop_id
# YOOKASSA_API_KEY=your_api_key

# Т-Банк (нужна при PAYMENT_PROVIDER=tbank):
# TBANK_TOKEN=your_token
# TBANK_MERCHANT_INN=7710140679
# TBANK_MERCHANT_KPP=771301001
# TBANK_BANK_BIC=044525974
# TBANK_CORRESPONDENT_ACCOUNT=30101810145250000974
# TBANK_ACCOUNT_NUMBER=40817810500019082167
# TBANK_CONTRACT_NUMBER=5225664399

# URL для редиректа после оплаты:
NEXT_PUBLIC_BASE_URL=http://localhost:3001
