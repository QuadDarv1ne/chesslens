// Схема данных ChessLens: аккаунты, сессии, подписки и платёжные поручения.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         String   @default("user") // user | admin
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions     Session[]
  orders       PaymentOrder[]
  subscription Subscription?
}

// Сессия пользователя: в cookie хранится только токен, сам объект — в БД.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Активная подписка пользователя (один тариф на аккаунт).
model Subscription {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      String   @default("free") // free | pro
  status    String   @default("active") // active | expired | canceled
  startsAt  DateTime @default(now())
  expiresAt DateTime?
  updatedAt DateTime @updatedAt
}

// Платёжное поручение и его состояние у провайдера.
model PaymentOrder {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String // yookassa | tbank | sbp
  plan            String // pro
  amount          Int // в копейках (RUB * 100)
  currency        String   @default("RUB")
  status          String   @default("pending") // pending | succeeded | canceled | failed | refunded
  externalId      String? // id платежа у провайдера
  confirmationUrl String?
  description     String?
  metadata        String? // JSON-строка для отладки
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  paidAt          DateTime?

  @@index([userId])
  @@index([externalId])
}
